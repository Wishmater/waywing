# Copy to .env.local. It is parsed by tool/wayland.dart, not sourced by a shell.
#
# Syntax: KEY=VALUE, comments on their own line, and single/double quoted
# values. $'...' supports \n, \r, \t, \\, \' and \". There is no $VAR expansion,
# command substitution, globbing or tilde expansion. Relative paths resolve
# against wayland/. Environment variables override this file.

# Path to the standalone Flutter engine (libflutter_engine.so). It must match
# the Flutter SDK/engine revision used to build the app.
FILO_ENGINE_LIB=/absolute/path/to/libflutter_engine.so

# Optional overrides. By default post-build records Flutter's icuDataPath and
# install records the exact flutter_assets directory.
# FILO_ICU_DATA=/absolute/path/to/icudtl.dat
# FILO_ASSETS=/absolute/path/to/flutter_assets

# Optional arguments for Dart's main(List<String> args), one per line:
# FILO_DART_ENTRYPOINT_ARGS=$'--dart-flag\na positional value'

# Optional filo switches:
# FILO_TRACE=1
# FILO_VULKAN_VALIDATION=1
# FILO_WINDOWING_SPIKE=1
# FILO_LAYER_ONLY=1
# FORCE_IMPELLER=1
